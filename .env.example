# Copy to .env for local development.
APP_ENV=development
APP_LOG_LEVEL=INFO

# Defaults to a local SQLite database so the stack runs with zero external services.
# Production: postgresql+psycopg://user:pass@localhost:5432/parts
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated origins allowed by CORS for the web app.
CORS_ORIGINS=http://localhost:3000

# Where uploaded images and generated artifacts live.
DATA_DIR=./data
ARTIFACT_DIR=./artifacts
UPLOAD_DIR=./uploads

# Vision baseline settings (classical descriptor, CPU-only).
VISION_IMAGE_SIZE=64
VISION_TOP_K=5

# Retrieval settings.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.08

# Forecast settings.
FORECAST_HORIZON_DAYS=30

# API base URL used by the Next.js app (server-side).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
